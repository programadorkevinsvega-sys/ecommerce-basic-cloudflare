{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-basic-cloudflare",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "cache": { "enabled": true, "cross_version_cache": false },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecommerce-vega-production",
      "database_id": "372088f2-d700-4155-9057-6595815a005e",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ecommerce-vega-production"
    }
  ],
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a49472c551f04d438a1b7a082d7468d9"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "ecommerce-vega-events-production"
      }
    ],
    "consumers": [
      {
        "queue": "ecommerce-vega-events-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ecommerce-vega-events-dlq-production"
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ecommerce_vega_analytics_production"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "9174301", "simple": { "limit": 20, "period": 60 } },
    { "name": "CHECKOUT_LIMITER", "namespace_id": "9174302", "simple": { "limit": 12, "period": 60 } },
    { "name": "API_WRITE_LIMITER", "namespace_id": "9174303", "simple": { "limit": 90, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
