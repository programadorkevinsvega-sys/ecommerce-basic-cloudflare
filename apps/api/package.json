{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "description": "Worker único: BFF y módulos de ecommerce",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:build-migrations": "node scripts/build-migrations.js",
    "db:migrate:local": "node scripts/build-migrations.js && node scripts/apply-migrations.js --local",
    "db:migrate:remote": "node scripts/build-migrations.js && node scripts/apply-migrations.js --remote",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "db:test-wrangler-migrations": "node scripts/test-empty-d1-migrations.js",
    "test:isolation": "node scripts/check-table-isolation.js",
    "test:architecture": "node scripts/check-architecture.js",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-architecture.js"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "hono": "^4.7.0",
    "qrcode-svg": "^1.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/qrcode-svg": "^1.1.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.36.0"
  }
}
