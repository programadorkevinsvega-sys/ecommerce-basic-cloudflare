{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "description": "Worker único: BFF y módulos de ecommerce",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:build-migrations": "node scripts/build-migrations.js",
    "db:migrate:local": "node scripts/build-migrations.js && wrangler d1 migrations apply ecommerce-db --local",
    "test": "vitest run",
    "test:isolation": "node scripts/check-table-isolation.js",
    "test:architecture": "node scripts/check-architecture.js",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-architecture.js"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "hono": "^4.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.4",
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
