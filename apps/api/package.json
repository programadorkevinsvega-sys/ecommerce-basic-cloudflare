{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "description": "Worker único: BFF y módulos de ecommerce",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:build-migrations": "node scripts/build-migrations.js",
    "db:migrate:local": "node scripts/build-migrations.js && node scripts/apply-migrations.js --local",
    "db:migrate:remote": "node scripts/build-migrations.js && node scripts/apply-migrations.js --remote",
    "test": "vitest run",
    "test:factus:sandbox": "node scripts/run-factus-sandbox-integration.mjs",
    "test:factus:sandbox:email": "node scripts/run-factus-sandbox-integration.mjs --send-email",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "db:test-wrangler-migrations": "node scripts/test-empty-d1-migrations.js",
    "test:isolation": "node scripts/check-table-isolation.js",
    "test:architecture": "node scripts/check-architecture.js",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-architecture.js"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/cloudflare": "^11.12.0",
    "hono": "^4.13.16",
    "pdf-lib": "^1.17.1",
    "qrcode-svg": "^1.1.0",
    "xss": "^1.0.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/qrcode-svg": "^1.1.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
