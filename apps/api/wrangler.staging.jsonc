{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-basic-cloudflare-staging",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "cache": { "enabled": true, "cross_version_cache": false },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecommerce-vega-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ecommerce-vega-staging"
    }
  ],
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "ecommerce-vega-events-staging"
      }
    ],
    "consumers": [
      {
        "queue": "ecommerce-vega-events-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ecommerce-vega-events-dlq-staging"
      }
    ]
  },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "9174311", "simple": { "limit": 20, "period": 60 } },
    { "name": "CHECKOUT_LIMITER", "namespace_id": "9174312", "simple": { "limit": 12, "period": 60 } },
    { "name": "API_WRITE_LIMITER", "namespace_id": "9174313", "simple": { "limit": 90, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "WOMPI_ENVIRONMENT": "sandbox",
    "RESEND_FROM_EMAIL": "Vega Store <onboarding@resend.dev>"
  }
}
