{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-basic-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecommerce-vega-production",
      "database_id": "9b69f19a-cad8-4e53-b0d1-0bd2adb11945",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ecommerce-vega-production"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a49472c551f04d438a1b7a082d7468d9"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "ecommerce-vega-events-production"
      }
    ],
    "consumers": [
      {
        "queue": "ecommerce-vega-events-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ecommerce-vega-events-dlq-production"
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ecommerce_vega_analytics_production"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
